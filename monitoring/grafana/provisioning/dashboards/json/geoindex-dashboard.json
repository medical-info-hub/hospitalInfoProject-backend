        { "expr": "geoindex_storage_flushedPages", "legendFormat": "Flushed Pages",  "refId": "B" },
        { "expr": "geoindex_storage_rebuildCount", "legendFormat": "Rebuild Count",  "refId": "C" },
        { "expr": "geoindex_storage_avgRebuildMs", "legendFormat": "Avg Rebuild Ms", "refId": "D" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity", "spanNulls": true, "showPoints": "never", "lineInterpolation": "smooth" },
