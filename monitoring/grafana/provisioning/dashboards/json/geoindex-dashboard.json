      "targets": [{ "expr": "geoindex_storage_rebuildCount", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
