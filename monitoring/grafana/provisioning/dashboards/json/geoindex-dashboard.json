{
  "title": "GeoIndex Engine",
  "uid": "geoindex-engine",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "graphTooltip": 1,
  "editable": true,
  "annotations": { "list": [] },
  "links": [],
  "panels": [

    { "type": "row", "id": 1, "title": "Overview", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "type": "stat", "id": 10, "title": "Cache Hit Rate",
      "gridPos": { "x": 0, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_cache_hitRate", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1, "decimals": 1,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.8 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto", "orientation": "auto" }
    },

    {
      "type": "stat", "id": 11, "title": "Total Queries",
      "gridPos": { "x": 5, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_index_queryCount", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "auto" }
    },

    {
      "type": "stat", "id": 12, "title": "Avg Page IDs / Query",
      "gridPos": { "x": 10, "y": 1, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_index_avgPageIds", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 1,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 200 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center" }
    },

    {
      "type": "stat", "id": 13, "title": "Dirty Pages",
      "gridPos": { "x": 14, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_storage_dirtyPages", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 200 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center" }
    },

    {
      "type": "stat", "id": 14, "title": "Rebuild Count",
      "gridPos": { "x": 19, "y": 1, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_storage_rebuildCount", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 20 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "justifyMode": "center" }
    },

    { "type": "row", "id": 2, "title": "Cache", "collapsed": false, "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 } },

    {
      "type": "stat", "id": 20, "title": "Cache Hit",
      "gridPos": { "x": 0, "y": 7, "w": 6, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_cache_hit", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "type": "stat", "id": 21, "title": "Cache Miss",
      "gridPos": { "x": 6, "y": 7, "w": 6, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_cache_miss", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "type": "stat", "id": 22, "title": "Cache Size",
      "gridPos": { "x": 12, "y": 7, "w": 6, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_cache_size", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500 },
            { "color": "red", "value": 900 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "type": "stat", "id": 23, "title": "Evict Count",
      "gridPos": { "x": 18, "y": 7, "w": 6, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_cache_evictCount", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "red", "value": 5000 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "type": "timeseries", "id": 60, "title": "Cache Hit Rate",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "geoindex_cache_hitRate", "legendFormat": "Hit Rate", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "green", "value": 0.8 }
          ]},
          "custom": {
            "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15,
            "gradientMode": "scheme", "spanNulls": true, "showPoints": "never",
            "lineInterpolation": "smooth",
            "thresholdsStyle": { "mode": "line+area" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } }
    },

    {
      "type": "timeseries", "id": 61, "title": "Cache Hit vs Miss",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "geoindex_cache_hit",        "legendFormat": "Hit",   "refId": "A" },
        { "expr": "geoindex_cache_miss",       "legendFormat": "Miss",  "refId": "B" },
        { "expr": "geoindex_cache_evictCount", "legendFormat": "Evict", "refId": "C" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity", "spanNulls": true, "showPoints": "never", "lineInterpolation": "smooth" },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Hit" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green"  } }] },
          { "matcher": { "id": "byName", "options": "Miss" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red"    } }] },
          { "matcher": { "id": "byName", "options": "Evict" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    },

    { "type": "row", "id": 3, "title": "Page", "collapsed": false, "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 } },

    {
      "type": "stat", "id": 30, "title": "Avg Intervals / Query",
      "gridPos": { "x": 0, "y": 19, "w": 8, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "geoindex_index_avgIntervals", "legendFormat": "", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
