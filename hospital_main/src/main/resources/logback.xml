<configuration>
	<appender name="CONSOLE"
		class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
		</encoder>
	</appender>

	<appender name="FILE"
		class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>logs/hospital.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>logs/hospital.%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>30</maxHistory>
			<totalSizeCap>1GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<logger name="org.hibernate.SQL" level="WARN" />
	<logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" />
	<logger name="org.hibernate" level="WARN" />
	<logger name="org.springframework.data" level="WARN" />
	<logger name="org.springframework.orm" level="WARN" />
	<logger name="org.springframework.transaction" level="WARN" />
	<logger name="org.apache.catalina" level="INFO" />
	<logger name="org.apache.jasper" level="INFO" />
	<logger name="org.apache.tomcat" level="INFO" />
	<logger name="org.quartz" level="debug" />
	<logger name="org.mariadb" level="WARN" />

	<logger name="org.springframework" level="INFO" />
	<logger name="com.hospital" level="debug" />

	<root level="INFO">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="FILE" />
	</root>
</configuration>